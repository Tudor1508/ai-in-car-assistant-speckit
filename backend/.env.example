# Exact allowed browser origins; set this to the configured frontend origin.
DRIVE_WISE_ALLOWED_ORIGINS=
DRIVE_WISE_API_HOST=
DRIVE_WISE_API_PORT=

# Optional local SQLite override. Default: backend/data/drive_wise.sqlite3
# DRIVE_WISE_DATABASE_URL=sqlite:///C:/path/to/drive_wise.sqlite3

# HeiGIT API key (formerly OpenRouteService); keep credentials in backend/.env only.
OPENROUTESERVICE_API_KEY=
# Geoapify Places key; keep this credential in backend/.env only.
GEOAPIFY_API_KEY=
# The provider URL and trip-planning options have built-in defaults.
OPENROUTESERVICE_TOURIST_CATEGORY_IDS=622,627

# AI travel assistant. OpenAI requests use the backend key and may incur charges.
# Keep the real key in backend/.env only. The model is optional and defaults to gpt-4.1-mini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Live integration scenarios; use locations/routes available to your ORS account.
TRIP_TEST_ACCOUNT_NAME=
TRIP_TEST_ACCOUNT_EMAIL=
TRIP_TEST_ACCOUNT_PASSWORD=
TRIP_TEST_VEHICLE_NAME=
TRIP_TEST_VEHICLE_MODEL=
TRIP_TEST_VEHICLE_YEAR=
TRIP_TEST_VEHICLE_MILEAGE_KM=
TRIP_TEST_ORIGIN_QUERY=
TRIP_TEST_UNRESOLVED_QUERY=
TRIP_TEST_DESTINATION_QUERY=
TRIP_TEST_VEHICLE_RANGE_KM=
TRIP_TEST_CURRENT_LEVEL_PERCENT=
TRIP_TEST_VEHICLE_TYPE=
TRIP_TEST_FUEL_TYPE=
TRIP_TEST_STOP_ORIGIN_QUERY=
TRIP_TEST_STOP_DESTINATION_QUERY=
TRIP_TEST_STOP_VEHICLE_RANGE_KM=
TRIP_TEST_STOP_CURRENT_LEVEL_PERCENT=
TRIP_TEST_NO_STATION_ORIGIN_QUERY=
TRIP_TEST_NO_STATION_DESTINATION_QUERY=
TRIP_TEST_NO_STATION_VEHICLE_RANGE_KM=
TRIP_TEST_NO_STATION_CURRENT_LEVEL_PERCENT=
TRIP_TEST_CURRENT_LOCATION_LATITUDE=
TRIP_TEST_CURRENT_LOCATION_LONGITUDE=

# Server policy: 30 minutes idle, 8 hours absolute.
