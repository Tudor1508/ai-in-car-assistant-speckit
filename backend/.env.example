# Exact allowed browser origins; never use a wildcard with credentials.
DRIVE_WISE_ALLOWED_ORIGINS=http://localhost:3000

# Optional local SQLite override. Default: backend/data/drive_wise.sqlite3
# DRIVE_WISE_DATABASE_URL=sqlite:///C:/path/to/drive_wise.sqlite3

# Server policy: 30 minutes idle, 8 hours absolute. No secrets are required.
